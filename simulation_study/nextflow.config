// Nextflow configuration for structured SIR simulations pipeline

manifest {
  name        = 'structured-sims-sir'
  description = 'Evaluate MASCOT-DS inference of pathogen transmission dynamics on structured SIR simulations'
  author      = 'Paula H. Weidemueller'
  nextflowVersion = '!>=22.10.0'
}

// Default parameters
// override via -params-file or -with-param
params {
  sample_seed = 42
  outdir      = 'results/'
  population_sizes = '50000 50000'
  ndemes = 2
  maxTime = 0.8
  endsWhen = 300
  chainlength = 1000000
  log_burnin = 20
  tree_burnin = 20
  logcombiner_resample = 1000
  conda_env = null  // Set per profile (local uses conda, wynton/docker use containers)

  // Container images for the Python/R pre/post-processing steps used by the
  // `wynton` and `docker` profiles. BEAST2 itself is NOT containerized —
  // beast_path/logcombiner_path/treeannotator_path must still point at a
  // local install (see README.md).
  //
  // Defaults below pull straight from Docker Hub (linux/amd64):
  //   https://hub.docker.com/repository/docker/phweide/biopython
  //   https://hub.docker.com/repository/docker/phweide/r-tidyverse
  // Plain "user/repo:tag" form — this is what Docker's engine expects (the
  // `docker://` prefix is Apptainer/Singularity-only syntax; Nextflow's
  // apptainer executor also accepts the plain form and resolves it against
  // the docker registry automatically).
  //
  // On a cluster where compute nodes have no internet access, pre-pull the
  // images to local .sif files on a login node (which does have internet):
  //   apptainer pull biopython.sif    docker://phweide/biopython:latest
  //   apptainer pull r-tidyverse.sif  docker://phweide/r-tidyverse:latest
  // then override these two params (e.g. via -params-file, a local config
  // included with -c, or directly on the CLI:
  //   --biopython_container /path/to/biopython.sif
  //   --rtidyverse_container /path/to/r-tidyverse.sif
  biopython_container  = 'phweide/biopython:latest'
  rtidyverse_container = 'phweide/r-tidyverse:latest'
}

// Common process configuration
// process {
   // errorStrategy = 'retry'
   // maxRetries = 2
// }

profiles {
  // Local development profile using Conda
  local {
    workDir = '/Users/pweidemuller/Documents/nextflow_work'

    params {
        conda_env = "/Users/pweidemuller/miniconda3/envs/biopython_env"
        beast_path = "/Applications/BEAST 2.7.7/bin/beast"
        logcombiner_path = "/Applications/BEAST 2.7.7/bin/logcombiner"
        treeannotator_path = "/Applications/BEAST 2.7.7/bin/treeannotator"
    }

    // Prepend the biopython_env bin/ directly onto PATH instead of using
    // Nextflow's native `conda` process directive: that directive shells out
    // to `conda activate`, which fails inside the non-interactive script
    // Nextflow spawns for each task (conda's activation hooks only load in
    // interactive/login shells, so `conda` isn't found there). Exporting PATH
    // directly needs no `conda` executable at task run time.
    process {
        executor = 'local'
        beforeScript = "export PATH=\"${params.conda_env}/bin:\$PATH\""
    }
  }

  // Wynton cluster profile using Apptainer + SGE.
  // Kept in a separate file so it's easy to ignore if you don't have Wynton
  // access, and easy to copy as a starting point for your own cluster — see
  // conf/wynton.config for details.
  wynton {
    includeConfig 'conf/wynton.config'
  }

  // Portable profile for reproducing the pipeline outside Wynton: runs
  // locally (or on any Docker-capable machine) using the published Docker
  // Hub images instead of a conda install. Requires Docker Desktop/Engine.
  //
  // BEAST2 is NOT containerized — install it yourself and point
  // beast_path/logcombiner_path/treeannotator_path at it, e.g.:
  //   nextflow run main.nf -profile docker \
  //       --beast_path /path/to/beast/bin/beast \
  //       --logcombiner_path /path/to/beast/bin/logcombiner \
  //       --treeannotator_path /path/to/beast/bin/treeannotator
  //
  // The images are linux/amd64 only; --platform linux/amd64 below makes
  // Docker emulate amd64 on Apple Silicon/ARM hosts (slower, but correct).
  docker {
    docker.enabled = true
    docker.runOptions = '--platform linux/amd64'

    process {
      executor = 'local'

      withName:SAMPLE_SIMPARAMS            { container = params.biopython_container }
      withName:MAKE_SIM_XML                { container = params.biopython_container }
      withName:SIMULATE_DATASTREAMS        { container = params.biopython_container }
      withName:MAKE_MASCOT_XML             { container = params.biopython_container }
      withName:ANALYSE_POSTERIORS          { container = params.biopython_container }
      withName:CONCATENATE_HPD_VALIDATION  { container = params.biopython_container }
      withName:PLOT_HPD_VALIDATION         { container = params.biopython_container }
      withName:CALCULATE_ESS               { container = params.biopython_container }
      withName:AGGREGATE_ESS               { container = params.biopython_container }
      withName:PLOT_ESS_HEATMAP            { container = params.biopython_container }
      withName:MAKE_INDIVIDUAL_SIM_FIGURES { container = params.biopython_container }
      withName:COMBINE_HPD_NE_BY_MODEL     { container = params.biopython_container }
      withName:QUANTIFY_INFORMATION_CONTENT { container = params.biopython_container }
      withName:MAKE_FIGURE_TRUE_VS_ESTIMATE { container = params.biopython_container }
      withName:MAKE_COMPOSITE_FIGURES_VOI  { container = params.biopython_container }

      withName:PLOT_TREES_GROUNDTRUTH { container = params.rtidyverse_container }
      withName:PLOT_TREES_MASCOT      { container = params.rtidyverse_container }
    }
  }
}

// Timeline and trace reports
timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution_timeline.html"
}

report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution_report.html"
}

trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution_trace.txt"
}

dag {
  enabled = true
  overwrite = true
  file = "${params.outdir}/dag.png"
}
