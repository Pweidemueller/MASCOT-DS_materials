// Wynton (UCSF) HPC cluster profile using Apptainer + SGE.
//
// This is the author's own working config for the Wynton cluster — kept as
// a concrete, complete example. If you're setting this pipeline up on a
// different cluster, copy this file (e.g. conf/mycluster.config), add a
// matching profile block to nextflow.config, and adjust:
//   - the executor (`sge` -> `slurm`, `lsf`, etc. — see the Nextflow
//     executor docs: https://www.nextflow.io/docs/latest/executor.html)
//   - `clusterOptions`/`penv` (scheduler-specific submission flags)
//   - `workDir` and the container/BEAST2 paths below
//
// If you don't have access to Wynton, you can ignore this file entirely and
// use the `docker` profile in nextflow.config instead.
apptainer {
  enabled = true
  autoMounts = true
}

// Set work directory to scratch space
workDir = "/wynton/scratch/${System.getenv('USER')}/nextflow_work"

params {
    beast_path = "/wynton/home/mueller/pweide/beast2.7/beast/bin/beast"
    logcombiner_path = "/wynton/home/mueller/pweide/beast2.7/beast/bin/logcombiner"
    treeannotator_path = "/wynton/home/mueller/pweide/beast2.7/beast/bin/treeannotator"

    // Wynton compute nodes have no internet access, so this profile
    // defaults to local .sif files pre-pulled on a login node (see the
    // biopython_container/rtidyverse_container comment in nextflow.config).
    // Override on the CLI (--biopython_container /your/path.sif) to use your own.
    biopython_container  = "/wynton/home/mueller/pweide/structured_sims/containers/biopython.sif"
    rtidyverse_container = "/wynton/home/mueller/pweide/structured_sims/containers/r-tidyverse.sif"
}

// Configure the SGE executor
process {
  executor = 'sge'
  // scratch = true
  stageInMode = 'symlink'
  stageOutMode = 'move'
  clusterOptions = '-S /bin/bash -o job.log -e job.err'
  penv = 'smp'

  // Default resource requirements
  cpus = 1
  memory = '10 GB'
  time = '1h'
}
process {
  withName:SAMPLE_SIMPARAMS {
            container = params.biopython_container
            cpus   = 1
            memory = '2GB'
            time   = '5min'
        }
  withName:MAKE_SIM_XML {
            container = params.biopython_container
            cpus   = 1
            memory = '2GB'
            time   = '5min'
        }
  withName:RUN_REMASTER {
            cpus   = 1
            memory = '10GB'
            time   = '10min'
        }
  withName:PLOT_TREES_GROUNDTRUTH {
            container = params.rtidyverse_container
            cpus   = 1
            memory = '10GB'
            time   = '10min'
        }
  withName:PLOT_TREES_MASCOT {
            container = params.rtidyverse_container
            cpus   = 1
            memory = '10GB'
            time   = '10min'
        }
  withName:SIMULATE_DATASTREAMS {
            container = params.biopython_container
            cpus   = 1
            memory = '2GB'
            time   = '10min'
        }
  withName:MAKE_MASCOT_XML {
            container = params.biopython_container
            cpus   = 1
            memory = '2GB'
            time   = '10min'
        }
  withName:RUN_MASCOT {
            cpus   = 1
            memory = '12GB'
            time   = '40h'
            // Retry failed jobs up to 2 times
            errorStrategy = 'retry'
            maxRetries = 2
            clusterOptions = "-S /bin/bash -o job.log -e job.err -pe smp 1 -l scratch=10G -l x86-64-v=4 -l h_vmem=20G"
        }
  withName:COMBINE_LOGS {
            cpus   = 1
            memory = '10GB'
            time   = '10min'
        }
  withName:COMBINE_TREES {
            cpus   = 1
            memory = '10GB'
            time   = '10min'
        }
  withName:ANNOTATE_TREES {
            cpus   = 1
            memory = '20GB'
            time   = '2h'
            clusterOptions = "-S /bin/bash -o job.log -e job.err -pe smp 1 -l scratch=18G -l x86-64-v=4 -l h_vmem=20G"
        }
  withName:ANALYSE_POSTERIORS {
            container = params.biopython_container
            cpus   = 1
            memory = '8GB'
            time   = '10min'
        }
  withName:CONCATENATE_HPD_VALIDATION {
            cpus   = 1
            memory = '10GB'
            time   = '10min'
  }
  withName:PLOT_HPD_VALIDATION {
            container = params.biopython_container
            cpus   = 1
            memory = '10GB'
            time   = '10min'
  }
  withName:CALCULATE_ESS {
            container = params.biopython_container
            cpus   = 1
            memory = '4GB'
            time   = '10min'
  }
  withName:AGGREGATE_ESS {
            cpus   = 1
            memory = '2GB'
            time   = '5min'
  }
  withName:PLOT_ESS_HEATMAP {
            container = params.biopython_container
            cpus   = 1
            memory = '4GB'
            time   = '10min'
  }
  withName:MAKE_INDIVIDUAL_SIM_FIGURES {
            container = params.biopython_container
            cpus   = 1
            memory = '8GB'
            time   = '10min'
  }
  withName:COMBINE_HPD_NE_BY_MODEL {
            container = params.biopython_container
            cpus   = 1
            memory = '10GB'
            time   = '10min'
  }
  withName:QUANTIFY_INFORMATION_CONTENT {
            container = params.biopython_container
            cpus   = 1
            memory = '8GB'
            time   = '10min'
  }
  withName:MAKE_FIGURE_TRUE_VS_ESTIMATE {
            container = params.biopython_container
            cpus   = 1
            memory = '8GB'
            time   = '10min'
  }
}

executor {
  queueSize = 500
}
